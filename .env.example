# ==========================================================
#  هفت منظومه — نمونه متغیرهای محیطی
#  این فایل را به نام .env.local کپی کنید و مقادیر را پر کنید.
#  توضیح کامل هر متغیر: docs/05-ops/environment.md
# ==========================================================

# --- عمومی ---
# آدرس پایه سایت؛ برای ساخت لینک هدیه و QR کد استفاده می‌شود.
APP_URL=http://localhost:3000

# --- دیتابیس (SQLite از طریق libsql) ---
# پیشوند file: الزامی است.
DATABASE_URL=file:./data/haft.db
# فقط در صورت اتصال به دیتابیس ریموت (Turso) لازم است.
# DATABASE_AUTH_TOKEN=

# --- امنیت ---
# کلید امضای کوکی سشن. در production حتماً مقدار تصادفی و حداقل ۳۲ کاراکتری بگذارید.
# تولید مقدار: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=haft-manzumeh-development-only-session-secret

# --- ذخیره‌سازی فایل ---
# مسیر نگهداری فایل‌های آپلودی (رسید پرداخت، تصویر کودک).
# باید بیرون از پوشه public باشد؛ سرو فایل‌ها از مسیر کنترل‌شده انجام می‌شود.
STORAGE_DIR=./storage

# --- پیامک ---
# console: کد فقط در ترمینال چاپ می‌شود (فقط توسعه)
# kavenegar: ارسال واقعی
SMS_PROVIDER=console
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=
# KAVENEGAR_OTP_TEMPLATE=

# --- قیمت طلا ---
# manual: قیمت را ادمین از پنل وارد می‌کند
# external: دریافت از سرویس بیرونی
GOLD_PRICE_PROVIDER=manual
# GOLD_PRICE_API_URL=
# GOLD_PRICE_API_KEY=

# --- راه‌اندازی اولیه ---
# شماره موبایل اولین سوپرادمین که با npm run db:seed ساخته می‌شود.
ADMIN_BOOTSTRAP_PHONE=09120000000

# --- توسعه ---
# اگر true باشد، کد یک‌بارمصرف در پاسخ سرور هم برگردانده می‌شود.
# هرگز در production فعال نکنید.
DEV_EXPOSE_OTP=true
