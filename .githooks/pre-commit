#!/bin/sh
#
# هوک پیش از کامیت هفت منظومه.
# هدف: هیچ کامیتی با نقض معماری یا خطای تایپ وارد تاریخ گیت نشود.
#
# رد کردن موقت (فقط در موارد استثنایی): git commit --no-verify

set -e

echo "بررسی پیش از کامیت..."

echo "  [۱/۳] تایپ‌چک"
npm run --silent typecheck

echo "  [۲/۳] لینت و مرزهای معماری"
npm run --silent lint

echo "  [۳/۳] بررسی ساختار و همگامی مستندات"
npm run --silent check:arch

echo "بررسی پیش از کامیت با موفقیت گذشت."
